# GEO 生文审核系统 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# LLM API Key（支持任意 OpenAI 兼容 API 提供商）
LLM_API_KEY=sk-your-api-key-here

# LLM 模型配置（可选，默认使用 OpenAI gpt-4o-mini）
# 切换其他模型示例：
#   通义千问: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1                        LLM_MODEL=deepseek-chat
#   智谱 GLM: LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# JWT 密钥（用于 token 签名，建议 64 字符以上）
# 可通过 python scripts/generate_secret_key.py 生成
AUTH_SECRET_KEY=your-secret-key-here

# 默认管理员密码（需包含大小写字母、数字、特殊字符，至少 12 位）
AUTH_ADMIN_PASSWORD=YourStrongPassword@123

# 数据库连接 URL
# 开发环境（SQLite，默认）：不设置此项即可使用 SQLite
# 生产环境（PostgreSQL）：
# DATABASE_URL=postgresql+asyncpg://geo_review:geo_review_secret@localhost:5432/geo_review

# 运行环境标记（production 影响缓存策略等行为）
# APP_ENV=production

# PostgreSQL 配置（Docker 部署时使用）
# POSTGRES_USER=geo_review
# POSTGRES_PASSWORD=geo_review_secret
